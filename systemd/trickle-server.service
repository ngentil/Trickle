[Unit]
Description=Trickle scheduler
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/trickle/server.env
WorkingDirectory=/opt/trickle/server
ExecStart=/opt/trickle/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8700 --proxy-headers
StateDirectory=trickle
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
