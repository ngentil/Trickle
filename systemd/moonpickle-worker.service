[Unit]
Description=Moon Pickle worker
After=network-online.target ModemManager.service tailscaled.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/moonpickle/worker.env
ExecStart=/usr/bin/python3 /opt/moonpickle/worker.py
Restart=always
RestartSec=15
# background citizen: lowest CPU and IO priority
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
