[Unit]
Description=Ratrun worker
After=network-online.target ModemManager.service tailscaled.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/ratrun/worker.env
ExecStart=/usr/bin/python3 /opt/ratrun/worker.py
Restart=always
RestartSec=15
# background citizen: lowest CPU and IO priority
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
